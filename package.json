{
  "name": "personal-site",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "eleventy-plugin-embed-everything": "^1.21.2",
    "hono": "^4.13.13",
    "markdown-it-attrs": "^5.0.1",
    "stylus": "^0.64.0"
  },
  "scripts": {
    "watch:11ty": "bun run eleventy --config=./eleventy.config.js --input=./src --output=./_site --serve",
    "watch:stylus": "bun run stylus --watch ./css --out ./src/static",
    "dev": "bun run --parallel watch:stylus watch:11ty"
  }
}
