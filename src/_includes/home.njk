---
layout: layout.njk
---
<section>
	<article>
		{{ content | safe }}
		<div class="socials">
			{%for item in socials%}
				<a href="{{ item.link }}" target="_blank">
					<img src="{{ item.icon }}">
				</a>
			{%endfor%}
		</div>
	</article>
</section>
<section>
<h2>Projects</h2>
{% for item in collections.portfolio %}
<article>
	<h3>
		{{ item.data.title }}
	</h3>
	{% if item.data.link %}<div class="project-link"><a href="{{ item.data.link }}" target="_blank">{{ item.data.link }}</a></div>{% endif %}
	{% if item.data.image %}<img src="{{ item.data.image }}" alt="{{ item.data.title }}">{% endif %}
	{{ item.content | safe }}
</article>
{% endfor %}
</section>
