@import url('https://fonts.googleapis.com/css2?family=Signika:wght@300..700&display=swap');

bg-colour = #1f0d14
title-colour = white
text-colour = #e3ddd3
link-colour = #ffdfa8
hover-text-colour = #e67455
main-margin = 1rem
alt-bg = #f5c19a
alt-colour = #572d35
alt-border-colour = #a17070
article-width = 80%
// width needed for an element inside an article to fill the whole section
article-breakout = (100% / article-width) * 100%

body
  background-color: bg-colour
  color: text-colour
  display: flex
  flex-direction: column
  align-items: center
  font-family: "Signika", sans-serif;
  font-size: 1.2rem
  padding: main-margin

section
  max-width: 80rem
  width: 100%

img
  display: block
  width: 100%
  margin: main-margin

p
  margin: main-margin 0

article
  width: article-width
  margin: 0 auto
  // images and videos break out of the article to use the whole section width
  > p:has(> img)
  > .eleventy-plugin-youtube-embed
    width: article-breakout !important
    margin-left: -((article-breakout - 100%) / 2)
  > p:has(> img) img
    margin: 0

for i in (1..6)
  h{i}
    text-align: center
    margin: main-margin
    color: title-colour

h6
  font-size: 1.3rem
h5
  font-size: 1.5rem
h4
  font-size: 2rem
h3
  font-size: 2.5rem
h2
  font-size: 4rem
h1
  font-size: 6rem

a
  text-decoration: none
  font-weight: bold
  &:link
  &:active
  &:visited
    color: link-colour
  &:hover
    color: hover-text-colour

.project-link
  display: block
  width: fit-content
  max-width: 100%
  margin: 0 auto
  text-align: center
  overflow-wrap: anywhere

.socials
  display: flex
  justify-content: center
  img
    width: 4rem

nav
  display: flex
  justify-content: center
  gap: main-margin
  font-size: 1.5rem

blockquote
  font-style: italic
  background-color: alt-bg
  color: alt-colour
  padding: main-margin
  margin: main-margin 0
  border-left: 0.5rem solid alt-border-colour